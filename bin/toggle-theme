#!/bin/bash

XDG_CONFIG_DIR="$HOME/.config/"
DOTFILE_DIR="$HOME/dotfiles/"

function gtk_dark() {
	gsettings set org.gnome.desktop.interface color-scheme prefer-dark
	gsettings set org.gnome.desktop.interface gtk-theme Adwaita-dark
}

function gtk_light() {
	gsettings set org.gnome.desktop.interface color-scheme prefer-light
	gsettings set org.gnome.desktop.interface gtk-theme Adwaita
}


function fuzzel_apply() {
    pkill -x fuzzel
    sleep 0.1
}

function fuzzel_light() {
    ln -sf "$DOTFILE_DIR/fuzzel/captuccin_latte.ini" "$DOTFILE_DIR/fuzzel/fuzzel.ini"
}
function fuzzel_dark() {
ln -sf "$DOTFILE_DIR/fuzzel/captuccin_frappe.ini" "$DOTFILE_DIR/fuzzel/fuzzel.ini"
}

vscode_theme() {
    local theme="$1"
    local config

    if [ -d "$HOME/.config/Code" ]; then
        config="$HOME/.config/Code/User/settings.json"
    elif [ -d "$HOME/.config/VSCodium" ]; then
        config="$HOME/.config/VSCodium/User/settings.json"
    else
        echo "VS Code/VSCodium config not found"
        return 1
    fi

    [ -f "$config" ] || echo "{}" > "$config"

    if command -v jq >/dev/null 2>&1; then
        tmp=$(mktemp)
        jq --arg t "$theme" '.["workbench.colorTheme"] = $t' "$config" > "$tmp" \
            && mv "$tmp" "$config"
    else
        if grep -q '"workbench.colorTheme"' "$config"; then
            sed -i "s/\"workbench.colorTheme\".*/\"workbench.colorTheme\": \"$theme\",/" "$config"
        else
            sed -i "1s|{|{\n  \"workbench.colorTheme\": \"$theme\",|" "$config"
        fi
    fi
}

vscode_dark() {
    vscode_theme "Monokai Dimmed"
}

vscode_light() {
    vscode_theme "Quiet Light"
}

function waybar_dark() {
	ln -sf ~/.config/waybar/style-dark.css ~/.config/waybar/style.css
}
function waybar_light() {
	ln -sf ~/.config/waybar/style-light.css ~/.config/waybar/style.css
}



STATE_FILE="$HOME/.local/state/theme-toggle/state.json"

function setup() {
	if [ -f "$STATE_FILE" ]
	then
		return
	fi

	mkdir -p "$(dirname $STATE_FILE)"
	echo '{"theme": "dark"}' > "$STATE_FILE"
}

function set_theme() {
	state="$(cat $STATE_FILE)"
	echo "$state" | jq --arg t "$theme" '.theme = $t' > "$STATE_FILE"
}


function get_theme() {
	current="$(jq -r '.theme' "$STATE_FILE")"
	echo "$current"
}

theme=""
function process_args() {
	if [ -z "$1" ]
	then
		echo "Please provide the argument 'dark', 'light' or 'switch'"
		exit 1
	fi

	if [ "$1" == "light" ] || [ "$1" == "dark" ]
	then
		theme="$1"
	elif [ "$1" == "switch" ]; then
		current="$(get_theme)"
		theme="dark"
		if [ "$current" == "dark" ]
		then
			theme="light"
		fi
		echo "$theme"
	else
		echo "Unkown argument, please provide the argument 'dark', 'light' or 'switch'"
		exit 1
	fi
}

function main() {
	for f in $(declare -F | grep "$theme" | awk '{ print($3) }')
	do 
		echo "$f"
		"$f"
	done

	for f in $(declare -F | grep 'apply' | awk '{ print($3) }')
	do 
		echo "$f"
		"$f"
	done
}

setup
process_args "$@"
main
set_theme


