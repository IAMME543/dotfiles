{
    "position": "top",
    "height": 32,
    "popup_autohide": true,
    "start": [
        {
            "type": "workspaces"
        }
    ],
    "center": [
        {
            "type": "clock",
            "format": "%H:%M"
        }
    ],
    "end": [
        {
            "type": "tray"
        },
        {
            "type": "notifications",
            "show_count": true,
            "icons": {
                "closed_none": "󰍥",
                "closed_some": "󱥂",
                "closed_dnd": "󱅯",
                "open_none": "󰍡",
                "open_some": "󱥁",
                "open_dnd": "󱅮"
            }
        },
        {
            "type": "battery",
            "format": ""
        },
        {
            "type": "custom",
            "bar": [
                {
                    "type": "button",
                    "name": "quick-settings-btn",
                    "label": "",
                    "on_click": "popup:toggle"
                }
            ],
            "popup": [
                {
                    "class": "popup-menu",
                    "type": "box",
                    "orientation": "vertical",
                    "widgets": [
                        {
                            "type": "label",
                            "name": "header",
                            "label": "Quick Settings"
                        },
                        {
                            "type": "network_manager",
                            "types_whitelist": [
                                "wifi"
                            ]
                        },
                        {
                            "type": "bluetooth"
                        },
                        {
                            "type": "volume",
                            "format": "{icon} {percentage}%",
                            "show_sources": false
                        },
                        {
                            "type": "brightness"
                        }
                    ]
                }
            ]
        },
        {
            "type": "custom",
            "class": "popup-menu",
            "bar": [
                {
                    "type": "button",
                    "name": "power-btn",
                    "label": "",
                    "on_click": "popup:toggle"
                }
            ],
            "popup": [
                {
                    "type": "box",
                    "orientation": "vertical",
                    "widgets": [
                        {
                            "type": "label",
                            "name": "header",
                            "label": "Power menu"
                        },
                        {
                            "type": "box",
                            "class": "popup-buttons",
                            "widgets": [
                                {
                                    "type": "button",
                                    "class": "power-btn",
                                    "label": "<span></span>",
                                    "on_click": "!shutdown now"
                                },
                                {
                                    "type": "button",
                                    "class": "power-btn",
                                    "label": "<span></span>",
                                    "on_click": "!reboot"
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}